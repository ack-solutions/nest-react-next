{
    "name": "@app/source",
    "version": "1.0.0",
    "private": true,
    "description": "Monorepo for nest-react-next",
    "scripts": {
        "web": "pnpm -C apps/web",
        "admin": "pnpm -C apps/admin",
        "api": "pnpm -C apps/api",
        "build": "pnpm -C apps/api build && pnpm -C apps/web build && pnpm -C apps/admin build",
        "test": "pnpm -r test",
        "lint": "pnpm -r run lint",
        "update-ackplus": "pnpm -r up --latest @ackplus/nest-auth @ackplus/nest-auth-client @ackplus/nest-auth-react @ackplus/nest-crud @ackplus/nest-crud-request @ackplus/nest-dynamic-templates @ackplus/react-tanstack-data-table @ackplus/nest-file-storage @ackplus/nest-seeder"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@types/lodash": "^4.17.21",
        "@types/node": "^20.11.0",
        "@typescript-eslint/eslint-plugin": "^8.49.0",
        "@typescript-eslint/parser": "^8.49.0",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "nx": "20.3.0",
        "prettier": "^2.6.2",
        "ts-loader": "^9.5.4",
        "turbo": "^2.6.3",
        "typescript": "5.9.3"
    }
}
