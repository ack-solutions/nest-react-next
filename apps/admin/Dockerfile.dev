# Admin dev Dockerfile: hot reload (Vite), no production build.
# Source directories are bind-mounted from the host while node_modules stays in the image.
FROM node:20-alpine
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY tsconfig.base.json ./
COPY libs ./libs
COPY apps/admin/package.json ./apps/admin/package.json

RUN pnpm install

COPY apps/admin ./apps/admin

EXPOSE 4200
