{
    "name": "@app/api",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "start": "nest start",
        "dev": "nest start --watch --webpack",
        "build": "nest build --webpack",
        "seed": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/@ackplus/nest-seeder/dist/cli.js -c ./src/seeder.config.ts",
        "seed:refresh": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/@ackplus/nest-seeder/dist/cli.js -c ./src/seeder.config.ts -r",
        "migration:create": "ts-node -r tsconfig-paths/register --project ./tsconfig.app.json  ./node_modules/typeorm/cli.js migration:create src/migrations/migration -t",
        "migration:generate": "ts-node -r tsconfig-paths/register --project ./tsconfig.app.json  ./node_modules/typeorm/cli.js migration:generate src/migrations/migration -d ./src/orm-config.ts",
        "migration:run": "ts-node -r tsconfig-paths/register --project ./tsconfig.app.json  ./node_modules/typeorm/cli.js migration:run -d ./src/orm-config.ts",
        "migration:rollback": "ts-node -r tsconfig-paths/register --project ./tsconfig.app.json  ./node_modules/typeorm/cli.js migration:revert -d ./src/orm-config.ts"
    },
    "dependencies": {
        "@ackplus/nest-auth": "catalog:",
        "@ackplus/nest-crud": "catalog:",
        "@ackplus/nest-crud-request": "catalog:",
        "@ackplus/nest-dynamic-templates": "catalog:",
        "@ackplus/nest-file-storage": "catalog:",
        "@ackplus/nest-seeder": "catalog:",
        "@aws-sdk/client-s3": "^3.1081.0",
        "@aws-sdk/s3-request-presigner": "^3.1081.0",
        "@azure/storage-blob": "^12.33.0",
        "@libs/types": "workspace:*",
        "@libs/utils": "workspace:*",
        "@nestjs-modules/ioredis": "^2.2.1",
        "@nestjs-modules/mailer": "^2.3.7",
        "@nestjs/common": "^11.1.28",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.1.28",
        "@nestjs/event-emitter": "^3.1.0",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.1.28",
        "@nestjs/swagger": "^11.4.5",
        "@nestjs/throttler": "^6.5.0",
        "@nestjs/typeorm": "^11.0.3",
        "@scalar/nestjs-api-reference": "^1.2.8",
        "apple-auth": "^1.0.9",
        "aws-sdk": "^2.1693.0",
        "bcrypt": "^6.0.0",
        "bcryptjs": "^3.0.3",
        "body-parser": "^2.3.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.4",
        "dotenv": "^17.4.2",
        "fb": "^2.0.0",
        "google-auth-library": "^10.9.0",
        "lodash": "catalog:",
        "mjml-browser": "^5.4.0",
        "nunjucks": "^3.2.4",
        "pg": "^8.22.0",
        "qrcode": "^1.5.4",
        "reflect-metadata": "^0.2.2",
        "request": "^2.88.2",
        "tslib": "catalog:",
        "typeorm": "^0.3.30"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.23",
        "@nestjs/schematics": "^11.1.0",
        "@nestjs/testing": "^11.1.28",
        "@types/body-parser": "^1.19.6",
        "@types/dotenv": "^8.2.3",
