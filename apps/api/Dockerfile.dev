# API dev Dockerfile: hot reload (NestJS), no production build.
# Source directories are bind-mounted from the host while node_modules stays in the image.
FROM node:20-alpine
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY tsconfig.base.json ./
COPY apps/api/package.json ./apps/api/package.json
COPY libs ./libs

RUN pnpm install

COPY apps/api ./apps/api

EXPOSE 3333
