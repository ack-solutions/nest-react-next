# API dev Dockerfile: hot reload (NestJS), no production build.
# Build context: repo root. Source + node_modules are mounted from host at runtime.
FROM node:20-alpine
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY tsconfig.base.json ./
COPY apps/api/package.json ./apps/api/package.json
COPY libs ./libs

RUN pnpm install

COPY apps/api ./apps/api

WORKDIR /app
EXPOSE 3333
