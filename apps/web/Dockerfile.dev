# Web dev Dockerfile: hot reload (Next.js), no production build.
# Source directories are bind-mounted from the host while node_modules stays in the image.
FROM node:20-alpine
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY tsconfig.base.json ./
COPY libs ./libs
COPY apps/web/package.json ./apps/web/package.json

RUN pnpm install

COPY apps/web ./apps/web

EXPOSE 3000
