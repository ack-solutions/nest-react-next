    "expo": {
        "doctor": {
            "reactNativeDirectoryCheck": {
                "exclude": [
                    "@ackplus/nest-auth-client",
                    "@ackplus/nest-auth-react",
                    "@babel/runtime",
                    "@libs/react-shared",
                    "@libs/types",
                    "@libs/utils",
                    "invariant",
