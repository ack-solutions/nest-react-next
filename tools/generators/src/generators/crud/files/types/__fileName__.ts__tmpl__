import { IBaseEntity } from "./base-entity";

export interface I<%= className %> extends IBaseEntity {<% columns.forEach(column => { %>
    <%= column.normalizeName.propertyName %><% if (column.nullable) { %>?<% } %>?: <%= column.tsType %>;<% }); %>
}
<% columns.forEach(column => { %><% if (column.type === 'enum' && column.enumValues) { %>

export enum <%= className %><%= column.normalizeName.className %>Enum {<% column.enumValues.forEach(value => { %>
    <%= value.toUpperCase() %> = '<%= value %>',<% }); %>
}<% } %><% }); %>
