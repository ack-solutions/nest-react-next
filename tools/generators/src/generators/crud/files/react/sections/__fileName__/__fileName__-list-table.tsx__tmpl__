import { QueryBuilder, WhereOperatorEnum } from '@ackplus/nest-crud-request';
import { useState, useCallback, useRef, MutableRefObject, useImperativeHandle, forwardRef, useMemo } from 'react';
import {
    DataTableColumn,
    DataTableHandle,
    IDataTableFilter,
    StatusChip,
} from '../../components';
import { I<%= className %>, PermissionsEnum } from '@libs/types';
import { use<%= className %> } from '@libs/react-shared';
import { Card, Button } from '@mui/material';
import { CrudTable, CrudTableActions } from '../../components/crud/crud-table';
import { toDisplayDate } from '@libs/utils';
import { useHasPermission } from '@ackplus/nest-auth-react';

export interface I<%= className %>TableFilter {
    // Add custom filters here
}

const defaultFilter: I<%= className %>TableFilter = {
    // Initialize default filter values
};

export interface <%= className %>ListTableProps {
    onEdit?: (row: I<%= className %>) => void;
    onRowClick?: (row: I<%= className %>) => void;
    hasSoftDelete?: boolean;
    onAdd?: () => void;
}

export interface <%= className %>ListTableRef {
    refresh: () => void;
}

const <%= className %>ListTable = forwardRef<<%= className %>ListTableRef, <%= className %>ListTableProps>(
    ({ onEdit, onAdd, onRowClick, hasSoftDelete = <%= features.softDelete ? 'true' : 'false' %> }, ref) => {
        const datatableRef = useRef<CrudTableActions>(null);
        const [tableFilter, setTableFilter] = useState(defaultFilter);
        const [countFilter, setCountFilter] = useState({});

        const canCreate = useHasPermission(PermissionsEnum.CREATE_<%= fileName.toUpperCase() %>);
        const canEdit = useHasPermission(PermissionsEnum.UPDATE_<%= fileName.toUpperCase() %>);
        const canDelete = useHasPermission(PermissionsEnum.DELETE_<%= fileName.toUpperCase() %>);

        // Expose refresh method through ref
        useImperativeHandle(ref, () => ({
            refresh: () => {
                datatableRef.current?.datatable?.refresh();
            },
        }));

            const {
            useGetMany<%= className %>,
            useDelete<%= className %>,
            <% if (features.softDelete) { %>
            useRestore<%= className %>,
            useDeleteForever<%= className %>,
            useBulkDelete<%= className %>,
            useBulkRestore<%= className %>,
            useBulkDeleteForever<%= className %>,
            <% } %>
        } = use<%= className %>();

        const handleRowClick = useCallback(
            (row: I<%= className %>) => {
                onRowClick(row);
            },
            [onRowClick],
        );

        const handleTrashData = useCallback((checked: boolean) => {
            setCountFilter((state) => {
                const newState = new QueryBuilder(state);
                newState.setOnlyDeleted(checked);
                return newState.toObject();
            });
        }, []);

        const handleDataTableApiRequestMap = useCallback(
            (queryBuilder: QueryBuilder, request: IDataTableFilter) => {
                if (request?.search) {
                    queryBuilder.orWhere('name', WhereOperatorEnum.ILIKE, `%${request?.search}%`);
                }

                return queryBuilder;
            },
            [],
        );

        const columns = useMemo<DataTableColumn<I<%= className %>>[]>(() => [
            <% columns.forEach(column => { %>
            {
                name: '<%= column.name %>',
                label: '<%= column.name.charAt(0).toUpperCase() + column.name.slice(1) %>',
                isSearchable: false,
                isSortable: true,
                <% if (column.type === 'enum') { %>
                renderCell: (params) => (
                    <StatusChip
                        variant="filled"
                        label={params.value}
                    />
                ),
                <% } else if (column.type === 'date') { %>
                renderCell: (params) => toDisplayDate(params.value),
                <% } else if (column.type === 'boolean') { %>
                renderCell: (params) => params.value ? 'Yes' : 'No',
                <% } %>
            },
            <% }); %>
        ], []);

            return (
            <Card>
                <CrudTable
                    crudName="<%= className %>"
                    crudPermissionKey="<%= fileName %>"
                    columns={columns}
                    ref={datatableRef}
                    <% if (features.softDelete) { %>
                    hasSoftDelete
                    <% } %>
                    // Permission props
                    canEdit={canEdit}
                    canDelete={canDelete}
                    canRestore={canDelete} // Usually same as delete permission
                    canDeleteForever={canDelete} // Usually same as delete permission
                    onToggleTrashData={handleTrashData}
                    dataTableApiRequestMap={handleDataTableApiRequestMap}
                    crudOperationHooks={{
                        useGetMany: useGetMany<%= className %>,
                        useDelete: useDelete<%= className %>,
                        <% if (features.softDelete) { %>
                        useRestore: useRestore<%= className %>,
                        useDeleteForever: useDeleteForever<%= className %>,
                        useBulkDelete: useBulkDelete<%= className %>,
                        useBulkRestore: useBulkRestore<%= className %>,
                        useBulkDeleteForever: useBulkDeleteForever<%= className %>,
                        <% } %>
                    }}
                    onEdit={canEdit ? onEdit : undefined}
                    onRowClick={canEdit ? handleRowClick : null}
                    extraFilter={(
                        canCreate ? (
                            <Button
                                variant="contained"
                                onClick={() => onAdd?.()}
                                sx={{ mb: 2 }}
                            >
                                Add <%= className %>
                            </Button>
                        ) : null
                    )}
                />
            </Card>
        );
    },
);

<%= className %>ListTable.displayName = '<%= className %>ListTable';

export default <%= className %>ListTable;
