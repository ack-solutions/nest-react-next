import { useCallback } from 'react';
import { Button } from '@mui/material';
import { LoadingButton } from '@mui/lab';

import { I<%= className %> } from '@libs/types';
import { DefaultDialog } from '../../components';
import <%= className %>Form from './<%= fileName %>-form';

export interface AddEdit<%= className %>DialogProps {
    onSubmit?: (values: I<%= className %>) => void;
    onClose?: () => void;
    initialValue?: Partial<I<%= className %>>;
}

export default function AddEdit<%= className %>Dialog({
    onClose,
    initialValue,
    onSubmit,
}: AddEdit<%= className %>DialogProps) {
    const handleSubmit = useCallback(
        (values: I<%= className %>) => {
            if (onSubmit) {
                onSubmit(values);
            }
            if (onClose) {
                onClose();
            }
        },
        [onSubmit, onClose]
    );

    return (
        <DefaultDialog
            onClose={onClose}
            title={initialValue?.id ? 'Edit <%= className %>' : 'Add <%= className %>'}
            maxWidth="md"
            fullWidth
        >
            <<%= className %>Form
                initialValue={initialValue}
                onSubmit={handleSubmit}
                onCancel={onClose}
                showActions={true}
                formId="add-edit-<%= fileName %>-form"
            />
        </DefaultDialog>
    );
}
