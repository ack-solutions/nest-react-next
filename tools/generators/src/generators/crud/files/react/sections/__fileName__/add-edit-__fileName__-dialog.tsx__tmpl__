import { useCallback, useEffect } from 'react';
import { Button, Stack } from '@mui/material';
import { LoadingButton } from '@mui/lab';
import { useForm } from 'react-hook-form';
import { yupResolver } from '@hookform/resolvers/yup';
import { DefaultDialog } from '../../components';
import { errorMessage, FormContainer, RHFTextField, use<%= className %>, useToasty } from '@libs/react-core';
import { object, string, number, boolean } from 'yup';
import { I<%= className %> } from '@libs/types';

export interface AddEdit<%= className %>DialogProps {
    onSubmit?: (values: I<%= className %>) => void;
    onClose?: () => void;
    initialValue?: Partial<I<%= className %>>
}

const validationSchema = yupResolver(object({
    <% columns.forEach(column => { %>
    <% if (column.type === 'string' || column.type === 'text' || column.type === 'file') { %>
    <%= column.normalizeName.propertyName %>: string()<% if (!column.nullable) { %>.required()<% } %>.label('<%= column.normalizeName.className %>'),
    <% } else if (column.type === 'number') { %>
    <%= column.normalizeName.propertyName %>: number()<% if (!column.nullable) { %>.required()<% } %>.label('<%= column.normalizeName.className %>'),
    <% } else if (column.type === 'boolean') { %>
    <%= column.normalizeName.propertyName %>: boolean().label('<%= column.normalizeName.className %>'),
    <% } else if (column.type === 'enum') { %>
    <%= column.normalizeName.propertyName %>: string()<% if (!column.nullable) { %>.required()<% } %>.label('<%= column.normalizeName.className %>'),
    <% } else { %>
    <%= column.normalizeName.propertyName %>: string()<% if (!column.nullable) { %>.required()<% } %>.label('<%= column.normalizeName.className %>'),
    <% } %>
    <% }); %>
}));

const defaultValues: Partial<I<%= className %>> = {
    <% columns.forEach(column => { %>
    <% if (column.type === 'string' || column.type === 'text' || column.type === 'file' || column.type === 'enum') { %>
    <%= column.normalizeName.propertyName %>: "",
    <% } else if (column.type === 'number') { %>
    <%= column.normalizeName.propertyName %>: 0,
    <% } else if (column.type === 'boolean') { %>
    <%= column.normalizeName.propertyName %>: false,
    <% } else { %>
    <%= column.normalizeName.propertyName %>: "",
    <% } %>
    <% }); %>
}

export default function AddEdit<%= className %>Dialog({
    onClose,
    initialValue,
    onSubmit,
}: AddEdit<%= className %>DialogProps) {

    const { useUpdate<%= className %>, useCreate<%= className %> } = use<%= className %>();
    const { mutateAsync: update<%= className %> } = useUpdate<%= className %>();
    const { mutateAsync: create<%= className %> } = useCreate<%= className %>();
    const { showToasty } = useToasty();

    const formContext = useForm({
        defaultValues,
        resolver: validationSchema,
    })
    const { reset } = formContext;

    const handleSubmit = useCallback(
        async (values: Partial<I<%= className %>>) => {
            try {
                let resp;
                if (initialValue?.id) {
                    resp = await update<%= className %>({
                        ...values,
                        id: initialValue?.id
                    })
                } else {
                    resp = await create<%= className %>(values)
                }

                if (onSubmit) { onSubmit(resp) }
                if (onClose) { onClose() }

                showToasty('<%= className %> successfully saved')
                return resp;
            } catch (error) {
                showToasty(errorMessage(error, "Error while saving <%= className %>"), 'error');
                throw error;
            }
        },

        [create<%= className %>, initialValue?.id, onClose, onSubmit, showToasty, update<%= className %>],
    )

    useEffect(() => {
        reset({
            ...initialValue,
        })
    }, [reset, initialValue]);

    return (
        <DefaultDialog
            onClose={onClose}
            title={initialValue?.id ? 'Edit <%= className %>' : 'Add <%= className %>'}
            actions={
                <>
                    <Button onClick={onClose}>Cancel</Button>
                    <LoadingButton
                        type="submit"
                        form="add-edit-<%= fileName %>-form"
                        variant="contained"
                        color="primary"
                        disabled={formContext?.formState?.isSubmitting}
                        loading={formContext?.formState?.isSubmitting}
                    >
                        Save
                    </LoadingButton>
                </>
            }
        >
            <FormContainer
                FormProps={{
                    id: "add-edit-<%= fileName %>-form"
                }}
                formContext={formContext}
                validationSchema={validationSchema}
                onSuccess={handleSubmit}
            >
                <Stack spacing={2}>
                 <% columns.forEach(column => { %>
                 <% if (column.type === 'boolean') { %>
                 <RHFCheckbox
                    label="<%= column.normalizeName.className %>"
                    name="<%= column.normalizeName.propertyName %>"
                />
                <% } else if (column.type === 'enum' && column.enum) { %>
                <RHFSelect
                    label="<%= column.normalizeName.className %>"
                    name="<%= column.normalizeName.propertyName %>"
                    options={[
                        <% column.enum.forEach(enumValue => { %>
                        { label: '<%= enumValue %>', value: '<%= enumValue %>' },
                        <% }); %>
                    ]}
                    fullWidth
                />
                <% } else if (column.type === 'text') { %>
                <RHFTextField
                    label="<%= column.normalizeName.className %>"
                    name="<%= column.normalizeName.propertyName %>"
                    multiline
                    rows={4}
                    fullWidth
                />
                <% } else if (column.type === 'file') { %>
                <RHFUpload
                    label="<%= column.normalizeName.className %>"
                    name="<%= column.normalizeName.propertyName %>"
                    accept="image/*"
                    fullWidth
                />
                <% } else { %>
                <RHFTextField
                    label="<%= column.normalizeName.className %>"
                    name="<%= column.normalizeName.propertyName %>"
                    <% if (column.type === 'number') { %>
                    type="number"
                    <% } %>
                    fullWidth
                />
                <% } %>
                <% }); %>
                </Stack>

            </FormContainer>
        </DefaultDialog>
    );
}
