import { useCallback, useEffect } from 'react';
import { useForm } from 'react-hook-form';
import { Stack, Button } from '@mui/material';
import { yupResolver } from '@hookform/resolvers/yup';
import { object, string, number, boolean } from 'yup';

import { I<%= className %> } from '@libs/types';
import { use<%= className %> } from '@libs/react-shared';
import {
    FormContainer,
    RHFTextField,
    RHFSelect,
    RHFCheckbox,
    RHFUpload
} from '@admin/app/form';
import { useToasty } from '../../hook';
import { errorMessage } from '@libs/utils';

const validationSchema = object().shape({
        <% columns.forEach(column => { %>
        <% if (column.type === 'string' || column.type === 'text') { %>
        <%= column.normalizeName.propertyName %>: string()<% if (!column.nullable) { %>.nullable()<% } %>,
        <% } else if (column.type === 'number') { %>
        <%= column.normalizeName.propertyName %>: number()<% if (!column.nullable) { %>.nullable()<% } %>,
        <% } else if (column.type === 'boolean') { %>
        <%= column.normalizeName.propertyName %>: boolean(),
        <% } else if (column.type === 'enum') { %>
        <%= column.normalizeName.propertyName %>: string()<% if (!column.nullable) { %>.nullable()<% } %>,
        <% } else if (column.type === 'file') { %>
        <%= column.normalizeName.propertyName %>: string()<% if (!column.nullable) { %>.nullable()<% } %>,
        <% } else { %>
        <%= column.normalizeName.propertyName %>: string()<% if (!column.nullable) { %>.nullable()<% } %>,
        <% } %>
        <% }); %>
    });

const defaultValues: Partial<I<%= className %>> = {
    <% columns.forEach(column => { %>
    <% if (column.type === 'string' || column.type === 'text' || column.type === 'file') { %>
    <%= column.normalizeName.propertyName %>: '',
    <% } else if (column.type === 'number') { %>
    <%= column.normalizeName.propertyName %>: 0,
    <% } else if (column.type === 'boolean') { %>
    <%= column.normalizeName.propertyName %>: false,
    <% } else if (column.type === 'enum') { %>
    <%= column.normalizeName.propertyName %>: '<%= column.enum ? column.enum[0] : '' %>',
    <% } else { %>
    <%= column.normalizeName.propertyName %>: '',
    <% } %>
    <% }); %>
};

export interface <%= className %>FormProps {
    initialValue?: Partial<I<%= className %>>;
    onSubmit?: (values: I<%= className %>) => void;
    onCancel?: () => void;
    submitLabel?: string;
    cancelLabel?: string;
    showActions?: boolean;
    formId?: string;
}

export default function <%= className %>Form({
    initialValue,
    onSubmit,
    onCancel,
    submitLabel = 'Save',
    cancelLabel = 'Cancel',
    showActions = true,
    formId = '<%= fileName %>-form',
}: <%= className %>FormProps) {
    const { useUpdate<%= className %>, useCreate<%= className %> } = use<%= className %>();
    const { mutateAsync: update<%= className %> } = useUpdate<%= className %>();
    const { mutateAsync: create<%= className %> } = useCreate<%= className %>();
    const { showToasty } = useToasty();

    const formContext = useForm({
        defaultValues,
        resolver: yupResolver(validationSchema) as any,
    });
    const { reset } = formContext;

    const handleSubmit = useCallback(
        async (values: Partial<I<%= className %>>) => {
            try {
                let resp;
                if (initialValue?.id) {
                    resp = await update<%= className %>({
                        ...values,
                        id: initialValue?.id,
                    });
                } else {
                    resp = await create<%= className %>(values);
                }

                if (onSubmit) {
                    onSubmit(resp);
                }

                showToasty('<%= className %> successfully saved');
                return resp;
            } catch (error) {
                showToasty(
                    errorMessage(error, 'Error while saving <%= className %>'),
                    'error'
                );
                throw error;
            }
        },
        [create<%= className %>, initialValue?.id, onSubmit, showToasty, update<%= className %>]
    );

    useEffect(() => {
        reset({
            ...defaultValues,
            ...initialValue,
        });
    }, [reset, initialValue]);

    return (
        <FormContainer
            formProps={{ id: formId }}
            formContext={formContext}
            onSuccess={handleSubmit}
        >
            <Stack spacing={2}>
                <% columns.forEach(column => { %>
                <% if (column.type === 'boolean') { %>
                <RHFCheckbox
                    label="<%= column.normalizeName.className %>"
                    name="<%= column.normalizeName.propertyName %>"
                />
                <% } else if (column.type === 'enum' && column.enum) { %>
                <RHFSelect
                    label="<%= column.normalizeName.className %>"
                    name="<%= column.normalizeName.propertyName %>"
                    options={[
                        <% column.enum.forEach(enumValue => { %>
                        { label: '<%= enumValue %>', value: '<%= enumValue %>' },
                        <% }); %>
                    ]}
                    fullWidth
                />
                <% } else if (column.type === 'text') { %>
                <RHFTextField
                    label="<%= column.normalizeName.className %>"
                    name="<%= column.normalizeName.propertyName %>"
                    multiline
                    rows={4}
                    fullWidth
                />
                <% } else if (column.type === 'file') { %>
                <RHFUpload
                    label="<%= column.normalizeName.className %>"
                    name="<%= column.normalizeName.propertyName %>"
                    accept="<%= column.type === 'file' ? 'image/*' : '*' %>"
                    fullWidth
                />
                <% } else { %>
                <RHFTextField
                    label="<%= column.normalizeName.className %>"
                    name="<%= column.normalizeName.propertyName %>"
                    <% if (column.type === 'number') { %>
                    type="number"
                    <% } %>
                    fullWidth
                />
                <% } %>
                <% }); %>

                {showActions && (
                    <Stack direction="row" spacing={2} justifyContent="flex-end">
                        {onCancel && (
                            <Button onClick={onCancel} variant="outlined">
                                {cancelLabel}
                            </Button>
                        )}
                        <Button
                            type="submit"
                            variant="contained"
                            color="primary"
                            disabled={formContext?.formState?.isSubmitting}
                            loading={formContext?.formState?.isSubmitting}
                        >
                            {submitLabel}
                        </Button>
                    </Stack>
                )}
            </Stack>
        </FormContainer>
    );
}
