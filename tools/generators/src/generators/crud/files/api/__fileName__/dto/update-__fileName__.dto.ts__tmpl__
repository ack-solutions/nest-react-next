import { ApiPropertyOptional } from '@nestjs/swagger';
import {
    IsString, IsInt, IsBoolean, IsDate, IsUUID, IsEnum,
    IsNumber, IsOptional
} from 'class-validator';
<% columns.forEach(column => { if (column.enumValues) { %>
import { <%= column.tsType %> } from '@libs/types';
<% }}) %>

export class Update<%= className %>DTO {
    <% columns.forEach(column => { %>
    @ApiPropertyOptional({
        type: '<%= column.swaggerType.toLowerCase() %>'<% if (column.enumValues) { %>,
        enum: <%= column.tsType %><% } %>,
        required: false
    })
<% column.validationDecorators.forEach(decorator => { %>    <%= decorator %>()
<% }); %>    @IsOptional()
    <%= column.normalizeName.propertyName %>?: <%= column.tsType %>;

<% }); %>}
