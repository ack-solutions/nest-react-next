import { ApiProperty } from '@nestjs/swagger';
import { Column, Entity } from 'typeorm';
<% columns.forEach(column => { %><% column.validationDecorators.forEach(decorator => { %>
import { <%= decorator.replace('@', '').replace('()', '') %> } from 'class-validator';
<% }); %><% }); %>

import { CoreEntity } from '../../core/typeorm/core.entity';

@Entity()
export class <%= className %> extends CoreEntity {
<% columns.forEach(column => { %>
    @ApiProperty(<%= column.swaggerType === 'enum' ? `{ enum: ${column.enumValues ? JSON.stringify(column.enumValues) : '[]'} }` : column.swaggerType === 'boolean' ? '{ type: Boolean }' : `{ type: ${column.swaggerType} }` %>)
<% column.validationDecorators.forEach(decorator => { %>    <%= decorator %>
<% }); %>    @Column(<%= column.columnOptionsString %>)
    <%= column.name %><%= column.nullable ? '?' : '' %>: <%= column.tsType %>;

<% }); %>}
