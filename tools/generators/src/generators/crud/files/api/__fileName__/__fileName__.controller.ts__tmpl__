import { NestAuthAuthGuard } from '@ackplus/nest-auth';
import { Crud } from '@ackplus/nest-crud';
import { ApiTags } from '@nestjs/swagger';
<% const hasFileUploadColumns = columns.some(col => col.type === 'file'); %>
<% if (hasFileUploadColumns) { %>
import {
    UseInterceptors,
    UploadedFile,
    Post,
    Body,
    Param,
    Put
} from '@nestjs/common';
import { FileInterceptor } from '@nestjs/platform-express';
import { UploadedFileStorage } from '@api/app/core/file-storage/uploaded-file-storage';
<% } %>

import { Create<%= className %>DTO } from './dto/create-<%= fileName %>.dto';
import { Update<%= className %>DTO } from './dto/update-<%= fileName %>.dto';
import { <%= className %> } from './<%= fileName %>.entity';
import { <%= className %>Service } from './<%= fileName %>.service';
import { RequestDataTypeInterceptor } from '../../core/interceptors/request-data-type.interceptor';

@ApiTags('<%= className %>')
@Crud({
    entity: <%= className %>,
    name: '<%= className %>',
    path: '<%= fileName %>',
    <% if (features.softDelete) { %>
    softDelete: true,
    <% } %>
    guards: [NestAuthAuthGuard],
    dto: {
        create: Create<%= className %>DTO,
        update: Update<%= className %>DTO,
    },
    routes: {
        counts: {
            enabled: true,
            interceptors: [new RequestDataTypeInterceptor()],
        },
        <% if (hasFileUploadColumns) { %>
        create: {
            interceptors: [FileInterceptor('file')],
        },
        update: {
            interceptors: [FileInterceptor('file')],
        },
        <% } %>
    },
})
export class <%= className %>Controller {

    constructor(
        private service: <%= className %>Service,
    ) {}

    <% if (hasFileUploadColumns) { %>
    @Post('upload')
    @UseInterceptors(FileInterceptor('file'))
    async uploadFile(
        @UploadedFile() file: UploadedFileStorage,
        @Body() body: any,
    ) {
        return this.service.uploadFile(file, body);
    }
    <% } %>
}
