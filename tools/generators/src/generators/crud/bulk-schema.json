{
    "$schema": "https://json-schema.org/schema",
    "$id": "BulkCRUD",
    "title": "Bulk CRUD Generator",
    "type": "object",
    "properties": {
        "configFile": {
            "type": "string",
            "description": "Path to the CRUD configuration file",
            "default": "crud.config.json",
            "x-prompt": "Path to config file?"
        },
        "entities": {
            "type": "array",
            "description": "Specific entities to generate (leave empty for all)",
            "items": {
                "type": "string"
            },
            "default": []
        },
        "skipExisting": {
            "type": "boolean",
            "description": "Skip entities that already exist",
            "default": false,
            "x-prompt": "Skip existing entities?"
        },
        "dryRun": {
            "type": "boolean",
            "description": "Show what would be generated without creating files",
            "default": false,
            "x-prompt": "Run in dry-run mode?"
        },
        "verbose": {
            "type": "boolean",
            "description": "Enable verbose logging",
            "default": false
        },
        "force": {
            "type": "boolean",
            "description": "Continue generation even if some entities fail",
            "default": false
        },
        "interactive": {
            "type": "boolean",
            "description": "Enable interactive prompts for conflict resolution",
            "default": true
        },
        "conflictResolution": {
            "type": "string",
            "enum": [
                "ask",
                "skip",
                "update",
                "backup"
            ],
            "description": "How to handle conflicts with existing files",
            "default": "ask",
            "x-prompt": {
                "message": "How should conflicts be handled?",
                "type": "list",
                "items": [
                    {
                        "value": "ask",
                        "label": "Ask for each conflict (interactive)"
                    },
                    {
                        "value": "skip",
                        "label": "Skip existing entities"
                    },
                    {
                        "value": "update",
                        "label": "Update (overwrite) existing files"
                    },
                    {
                        "value": "backup",
                        "label": "Update with backup"
                    }
                ]
            }
        },
        "createBackup": {
            "type": "boolean",
            "description": "Create backup files when updating existing entities",
            "default": false,
            "x-prompt": "Create backup files when updating?"
        }
    },
    "required": []
}
